# Dois bancos na nuvem (dois projetos Supabase distintos):
#   .env.development.local -> usado por `npm run dev`   (banco de DESENVOLVIMENTO)
#   .env.production.local  -> usado por `npm run build` (banco de PRODUÇÃO)
# Em produção (ex.: Vercel), defina as mesmas variáveis no painel do provedor.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-ou-publishable-key

# Backup (opcional): APP_ENV=development|production npm run backup
# SUPABASE_SERVICE_ROLE_KEY=nunca-commitar

# Imagens de produto (S3). Veja a seção "Imagens de produto" do README.
# URL pública do bucket (ou da CloudFront) - exposta ao navegador; sem ela o envio de fotos fica oculto:
VITE_PRODUCT_IMAGES_BASE_URL=https://seu-bucket.s3.sa-east-1.amazonaws.com
# Credenciais - SOMENTE servidor (função /api/product-images). Nunca use o prefixo VITE_:
S3_BUCKET=seu-bucket
S3_REGION=sa-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
