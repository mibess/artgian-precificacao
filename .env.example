# Dois bancos na nuvem (dois projetos Supabase distintos):
#   .env.development.local -> usado por `npm run dev`   (banco de DESENVOLVIMENTO)
#   .env.production.local  -> usado por `npm run build` (banco de PRODUÇÃO)
# Em produção (ex.: Vercel), defina as mesmas variáveis no painel do provedor.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-ou-publishable-key

# Backup (opcional): APP_ENV=development|production npm run backup
# SUPABASE_SERVICE_ROLE_KEY=nunca-commitar
